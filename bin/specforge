#!/usr/bin/env python3
"""specforge: one entry point for the plugin's scripts (M13).

Claude Code puts a plugin's bin/ on the PATH, so the commands can call
`specforge state get` instead of `python3 "${CLAUDE_PLUGIN_ROOT}/scripts/state.py" get`,
and a headless run can allow it with the exact rule Bash(specforge:*).
CLAUDE_PLUGIN_ROOT isn't set in the shell, so the scripts are found from here.
There is deliberately no way to approve or unapprove: only a prompt the user
submits does that (M5, M6).
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))

USAGE = """usage: specforge <command> [args]

  specforge state get|init|set-phase <phase>|set-mode <mode>|bump
  specforge red [--all]                record RED for the current task (--all: check every task, record nothing)
  specforge spec-size                  count ACs against the source and the budget
  specforge test [AC-ID ...]           run the tests as the commit gate does (AC-IDs: only theirs, with test_filter)
  specforge config                     print .spec/config.json with defaults filled in
  specforge trace --plan|--tests|--rollup|--edges
  specforge import <file> [<file> ...] copy source files into .spec/source.md
  specforge version-check              warn if Claude Code is too old

Approving and unapproving aren't here: type /specforge:approve or
/specforge:unapprove yourself."""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0 if argv else 2
    command, rest = argv[0], argv[1:]
    if command in ("approve", "unapprove") or (command == "state" and rest[:1] and rest[0] in ("approve", "unapprove")):
        print("specforge: only the user can approve or withdraw an approval. Type "
              "/specforge:approve spec|plan or /specforge:unapprove spec|plan yourself.", file=sys.stderr)
        return 2
    if command == "state":
        import state
        return state.main(rest)
    if command == "test":
        import run_tests
        return run_tests.main(rest)
    if command == "config":
        import config
        return config.main(rest)
    if command == "red":
        import red
        return red.main(rest)
    if command == "spec-size":
        import spec_size
        return spec_size.main(rest)
    if command == "trace":
        import trace_check
        return trace_check.main(rest)
    if command == "import":
        import import_source
        return import_source.main(rest)
    if command == "version-check":
        import version_check
        return version_check.main()
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
